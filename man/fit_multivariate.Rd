\name{fit_multivariate}
\alias{fit_multivariate}
\title{Johnson-Transformed Multivariate Normal Model}
\description{Fit Johnson marginals, transform observations and estimate dependence in normal space.}
\usage{fit_multivariate(data, columns = NULL, na_action = c("fail", "omit"),
  ridge = 0, johnson_types = c("SU", "SL", "SB"), ks_warning = 0.2, ...)}
\arguments{
\item{data}{Numeric matrix or data frame with at least two variables.}
\item{columns}{Optional column selection.}
\item{na_action}{Fail or use complete-case observations.}
\item{ridge}{Explicit diagonal regularization, zero by default.}
\item{johnson_types}{Johnson marginal types.}
\item{ks_warning}{Descriptive marginal warning threshold.}
\item{...}{Other arguments to fit_univariate; not families, na_action or component.}}
\value{A \code{familyfit_multivariate} object with marginals, Z, covariance/correlation and data audit.}
\details{Covariance and correlation describe transformed Z variables. The normal maximum likelihood estimation (MLE) covariance uses divisor n.
Information criteria describe the Z-space normal model conditional on fitted marginals;
they do not describe the original-scale joint model and must not be used to compare models with different fitted transformations. With regularization AIC/BIC are unavailable.
Singular covariance is reported rather than silently regularized.
Each marginal is mapped to the normal scale by its fitted Johnson (1949)
transformation; the resulting dependence summaries are descriptive.}
\references{
Karakaya Demir, Ş. Ş., Purutçuoğlu, V. and Bursalı, A. (2026). Modeling Mobile
Application Usage with Distribution Families. Accepted at the 3rd
International Conference on Advanced Technology in Electronic and Electrical
Engineering (ICATEEE 2026), Hammamet, Tunisia.

Johnson, N. L. (1949). Systems of frequency curves generated by methods of
translation. \emph{Biometrika}, 36(1--2), 149--176.
\doi{10.1093/biomet/36.1-2.149}
}

\examples{
set.seed(2026)
z <- rnorm(60)
d <- data.frame(first = sinh(z), second = sinh(.5 * z + rnorm(60)))
f <- fit_multivariate(d, johnson_types = "SU")
f$correlation_Z
}
